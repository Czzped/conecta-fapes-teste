    <bpmn:textAnnotation id="TextAnnotation_0298ox7">
      <bpmn:text>Olhar o sistema atual e outros sistemas</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0m902iu">
      <bpmn:text>Registrar no Docsauros artefatos encontrados, como telas e planilhas no docsauros</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06qpaht">
      <bpmn:text>Registrar Docsauros</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0g4dlpe">
      <bpmn:text>Necessário apoio de time UX como facilitador na equipe. Protótipo precisa ser real</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0s3gyt4">
      <bpmn:text>Fazer diagramas e análise relativo às mudanças no Banco de Dados

Definir rotas mínimas

Definir JSON padrão para desenvolvimento desacoplado de front e back

Detalhar histórias de usuários</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
