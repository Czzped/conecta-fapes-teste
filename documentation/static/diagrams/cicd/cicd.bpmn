    <bpmn:messageFlow id="Flow_0o5exkp" sourceRef="Activity_1rclri1" targetRef="Participant_0cpfn89" />
    <bpmn:messageFlow id="Flow_0t6bi5b" name="Start Code Review Process" sourceRef="Event_05vmjhx" targetRef="Participant_031d0s8" />
    <bpmn:messageFlow id="Flow_18232kd" name="Start Develop Process" sourceRef="Event_0v9jq2f" targetRef="Participant_1phd0qv" />
    <bpmn:textAnnotation id="TextAnnotation_1atgdyf">
      <bpmn:text>SVC do LEDS: gitlab.com</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1isdcca">
      <bpmn:text>Branchs:
* develop
* main
* release</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1s8gzbp">
      <bpmn:text>Project Description
Objective
Involved Parties (Stakeholders, Project Lead, Developers, Code Reviewers, QA &amp; DevOps)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tkd2pd">
      <bpmn:text>leds-&lt;projeto&gt;-&lt;artefato&gt;</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0533nok">
      <bpmn:text>Make the 'First commit' with Readme.md on the "main" branch, then merge and push to the other branches.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0wqrpbc">
      <bpmn:text>feature-name according Jira</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1vegto9">
      <bpmn:text>Existe Sub-feature?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bt9mu4">
      <bpmn:text>Ensure that different modules or components of the system work correctly together.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ednlbz">
      <bpmn:text>Notificate ERROR to user on Colaboration &amp; Communication Tool</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0hznnkc">
      <bpmn:text>Notificate SUCESS to user on Colaboration &amp; Communication Tool</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1i6da4g" associationDirection="None" sourceRef="Activity_05vgm4u" targetRef="TextAnnotation_0wqrpbc" />
    <bpmn:association id="Association_165qeqd" associationDirection="None" sourceRef="Activity_05vgm4u" targetRef="TextAnnotation_1vegto9" />
    <bpmn:textAnnotation id="TextAnnotation_1m73rrt">
      <bpmn:text>Evaluates whether the code follows best programming practices, such as clear naming conventions, short functions, and proper modularization.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1vq20zy">
      <bpmn:text>The code should be easy to understand. Comments, when necessary, should be clear and explanatory.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04rnzl2">
      <bpmn:text>Checks if the code is easy to modify and maintain in the future. This involves modularity, simplicity, and the absence of code duplication.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1abmebm">
      <bpmn:text>Analyzes potential performance issues or inefficiencies, such as unnecessary loops, excessive memory usage, or improper use of resources.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0r4g49w">
      <bpmn:text>Identifies potential vulnerabilities, such as insufficient input validation or the use of outdated libraries that could be exploited.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_10zhb2k">
      <bpmn:text>Ensures the code includes proper automated tests and covers key functionalities. It’s important that new tests are added for new features or changes.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1v29r19" associationDirection="None" sourceRef="Activity_04yzc4i" targetRef="TextAnnotation_1m73rrt" />
    <bpmn:association id="Association_1sqord6" associationDirection="None" sourceRef="Activity_0xyoofh" targetRef="TextAnnotation_04rnzl2" />
    <bpmn:association id="Association_11i1x9y" associationDirection="None" sourceRef="Activity_123hrbh" targetRef="TextAnnotation_1abmebm" />
    <bpmn:association id="Association_0mu2yog" associationDirection="None" sourceRef="Activity_07c6rwz" targetRef="TextAnnotation_0r4g49w" />
    <bpmn:association id="Association_0ki29x4" associationDirection="None" sourceRef="Activity_0cvfpsz" targetRef="TextAnnotation_10zhb2k" />
    <bpmn:association id="Association_0v2aq4i" associationDirection="None" sourceRef="Activity_1mg6hux" targetRef="TextAnnotation_1vq20zy" />
    <bpmn:textAnnotation id="TextAnnotation_1g8y7m9">
      <bpmn:text>The code should follow the formatting and style guidelines set by the team or project, such as linting standards</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ef5enl" associationDirection="None" sourceRef="Activity_0g7k8tu" targetRef="TextAnnotation_1g8y7m9" />
    <bpmn:textAnnotation id="TextAnnotation_1l8zocj">
      <bpmn:text>Verifies that there is adequate documentation, especially for APIs or complex parts of the code, making it easier for other developers to understand and integrate.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ronboc" associationDirection="None" sourceRef="Activity_1u4txar" targetRef="TextAnnotation_1l8zocj" />
  </bpmn:collaboration>
