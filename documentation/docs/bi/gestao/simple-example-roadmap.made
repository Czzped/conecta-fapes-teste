backlog ideias {
    name : "Ideias a serem pensadas"
    description : "Backlog para ideias futuras e estudo"

    epic cdc {name: "Estudar CDC"}
}


process processoCriacaoDashboard {
        name: "Processo de Criação de Dashboard"
        description: "Criar um dashboard com metricas para apoiar a tomada de decisão"

        activity identificarobjetivos{
            name: "Identificar objetivos"
            description: "Queremos identificar quais objetivos organizacionais estão relacionados "

            task entrevista {
                name: "Entrevistar"
                description: "Entrevista os clientes para levantar os objetivos organizacionais relacionados"
            }

            task validar {
                name: "Validar dos da entrevista"
                description: "Validar objetivos organizacionais"
                
            }    
        }

        activity IdentificarNecessidadeInformacao{
            name: "Identificar as necessidades de informacao"
            description: "Identificar quais informações são relevantes para responder os objetivos organizacionais"
            

            task entrevista {
                name: "Entrevistar"
                description: "Entrevista os clientes para levantar os objetivos organizacionais "
            
            }

            task validar {
                name: "Validar necessidade de informação"
                description: "Validar as necessidade de informação"
            
            }
    
        }

        activity definirmedidasIndicadores{
            name: "Identificar as Medidas e Indicadores"
            description: "Identificar quais informações são as medidas e indicadores para as necessidades de informação"
            
            
            task pesquisar {
                name: "Pesquisar sobre Medidas e Indicadores"
                description: "Pesquisar sobre medidas e indicadores para atender a necessidade de informações"
                
            }

            task validar {
                name: "Validar as medidas e indicadores "
                description: "Validar medias e indicadores"
                
            }
    
        }

} 


backlog BI {
   name: "Backlog do BI"
   description: "Backlog dedicado a equipe de BI"

   epic IdentificarObjetivo {
        name: "Criar dashboard ligado a bolsas"
        description: "Criar um dashboard com metricas sobre bolsas para apoiar a tomada de decisão"

        story identificarobjetivos{
            name: "Identificar objetivos"
            description: "Queremos identificar quais objetivos organizacionais estão relacionado a bolsa"

            task entrevista {
                name: "Entrevistar"
                description: "Entrevista os clientes para levantar os objetivos organizacionais relacionados bolsa"
            }

            task validar {
                name: "Validar dos da entrevista"
                description: "Validar objetivos organizacionais"
                depends: BI.IdentificarObjetivo.identificarobjetivos.entrevista
            }    
        }

        story IdentificarNecessidadeInformacao{
            name: "Identificar as necessidades de informacao"
            description: "Identificar quais informações são relevantes para responder os objetivos organizacionais"
            depends: BI.IdentificarObjetivo.identificarobjetivos

            task entrevista {
                name: "Entrevistar"
                description: "Entrevista os clientes para levantar os objetivos organizacionais relacionados bolsa"
                depends: BI.IdentificarObjetivo.identificarobjetivos.validar
            }

            task validar {
                name: "Validar necessidade de informação"
                description: "Validar as necessidade de informação"
                depends: BI.IdentificarObjetivo.IdentificarNecessidadeInformacao.entrevista 
            }
            
    
        }

        story definirmedidasIndicadores{
            name: "Identificar as Medidas e Indicadores"
            description: "Identificar quais informações são as medidas e indicadores para as necessidades de informação"
            depends: BI.IdentificarObjetivo.IdentificarNecessidadeInformacao
            
            task pesquisar {
                name: "Pesquisar sobre Medidas e Indicadores"
                description: "Pesquisar sobre medidas e indicadores para atender a necessidade de informações"
                depends:  BI.IdentificarObjetivo.identificarobjetivos.validar
            }

            task validar {
                name: "Validar as medidas e indicadores "
                description: "Validar medias e indicadores"
                depends: BI.IdentificarObjetivo.definirmedidasIndicadores.pesquisar
            }
    
        }
        
   }
 
   epic levantarInfraestruturaLEDS {
    name: "Levantar Infraestrutura de ETL"
    description: "Construir uma infraestrutura conectando o banco Conecta ao Stage Data e Power BI, com Apache Airflow."

    story levantarDataStage {
        name: "Configurar o banco Stage Data"
        description: "Configurar o banco de dados Stage Data para armazenar os dados extraídos do banco Conecta."

        task alinharComDevops {
            name: "Alinhar com a equipe de DevOps"
            description: "Alinhar permissões e acessos do bnaco com a equipe de DevOps."
        }

        task verificarFuncionamentoDataStage {
            name: "Verificar funcionamento do Stage Data"
            description: "Testar a conectividade e validação do banco Stage Data"
            depends: BI.levantarInfraestruturaLEDS.levantarDataStage.alinharComDevops
        }
    }

    story configurarAirflowETL {
        name: "Configurar o Airflow para pipelines ETL"
        description: "Configurar o Airflow para extrair dados do banco Conecta, transformá-los e carregá-los no banco Stage Data."
        depends: BI.levantarInfraestruturaLEDS.levantarDataStage.verificarFuncionamentoDataStage

        task instalarConfigurarAirflow {
            name: "Instalar e configurar o Airflow"
            description: "Instalar o Airflow e configurar conexões com os bancos Conecta e Stage Data."
        }

        task criarArquivoPythonETL {
            name: "Criar arquivos Python para ETL"
            description: "Criar arquivos Python para duplicar o formato da tabela do Banco do Conecta para o Banco do BI"
            depends: BI.levantarInfraestruturaLEDS.configurarAirflowETL.criarDAGsETL
        }

        task criarArquivoPythonETL2 {
            name: "Criar arquivos Python para ETL"
            description: "Criar arquivos Python para duplicar o formato da tabela do Banco do Conecta para o Banco do BI."
            depends: BI.levantarInfraestruturaLEDS.configurarAirflowETL.criarDAGsETL
        }
        
        task criarDAGsETL {
            name: "Transformar arquivos Python em DAGs"
            description: "Transformar os arquivos Python em DAGs para execução no Airflow."
            depends: BI.levantarInfraestruturaLEDS.configurarAirflowETL.criarArquivoPythonETL
        }

        task testarPipelinesETL {
            name: "Testar pipelines ETL"
            description: "transformar as DAGS pipelines criados."
            depends: BI.levantarInfraestruturaLEDS.configurarAirflowETL.criarDAGsETL
        }
    }

    story conectarBancoAoPowerBI {
        name: "Conectar banco Stage Data ao Power BI"
        description: "Integrar o banco Stage Data ao Power BI para criar relatórios baseados nos dados processados do Stage Data."
        depends: BI.levantarInfraestruturaLEDS.configurarAirflowETL.testarPipelinesETL

        task importarDadosNoPowerBI {
            name: "Importar dados no Power BI"
            description: "Configurar a conexão do Power BI com o banco Stage Data e importar dados."
        }

        task criarModeloPowerBI {
            name: "Criar modelo de dados no Power BI"
            description: "Configurar relacionamentos e transformações no Power BI para estruturar os dados para visualização."
            depends: BI.levantarInfraestruturaLEDS.conectarBancoAoPowerBI.importarDadosNoPowerBI
        }

        task criarRelatoriosPowerBI {
            name: "Validar relatórios e gráficos no Power BI"
            description: "Garantir que os relatórios e gráficos gerados no Power BI estão corretos e atendem aos requisitos do projeto."
            depends: BI.levantarInfraestruturaLEDS.conectarBancoAoPowerBI.criarModeloPowerBI
        }
    }

 
   }


    epic instalarAirflow {
        name: "Instalar e configurar o Apache Airflow"
        description: "Instalar e configurar o Apache Airflow para uso no projeto de BI"

        story instalarAirflow {
            name: "Instalar o Apache Airflow"
            description: "Instalar o Apache Airflow no ambiente de desenvolvimento"
        }

        story configurarConexoes {
            name: "Configurar conexões"
            description: "Configurar conexões com bancos de dados no Apache Airflow"
            depends: BI.instalarAirflow.instalarAirflow

            task testarConexoes {
                name: "Testar conexões"
                description: "Testar as conexões com os bancos de dados no Apache Airflow"
                depends: BI.instalarAirflow.configurarConexoes
            }
        }

        story criarDAGs {
            name: "Criar DAGs"
            description: "Criar DAGs para execução de tarefas de ETL no Apache Airflow"
            depends: BI.instalarAirflow.configurarConexoes

            task criarDAGs {
                name: "Criar DAGs"
                description: "Criar DAGs de duplicar o formato da tabela do Banco do Conecta para o Banco do BI"
            }
            task criarDags2 {
                name: "Criar DAGs"
                description: "Criar DAGs de duplicar os dados da tabela do Banco do Conecta para o Banco do BI"
            }
        }

        story subirRepositorio {
            name: "Subir repositório no GitHub"
            description: "Subir o repositório do projeto de BI no GitHub"
        
            task testarRepositorio {
                name: "Testar repositório"
                description: "Outra pessoa o airflow que esta no GitHub"
                depends: BI.instalarAirflow.criarDAGs
            }
        }

    }
}





backlog BacklogSprint4 {
    name: "Backlog inicio do ano"
    


    epic deployPrototipoBolsaProdest {
        name: "Deploy do protótipo de Bolsa na Prodest"
        description: "Deploy do protótipo de Bolsa na Prodest, sem live coonection"

        story deployPrototipoBolsaProdest {
            name: "Deploy do protótipo de Bolsa na Prodest"
            description: "Deploy do protótipo de Bolsa na Prodest, sem live coonection"

            task deployPrototipoBolsaProdest {
                name: "Deploy do protótipo de Bolsa na Prodest"
                description: "Deploy do protótipo de Bolsa na Prodest, sem live coonection"
            }
            task deployPrototipoBolsaProdestRS {
                name: "transferir Paineis para a versão do Power BI Desktop adaptado para RS, versão maio 2024"
                description: "Deploy do protótipo de Bolsa na Prodest, sem live coonection"
            }
            task deployPrototipoBolsaProdestRS2 {
                name: "transferir Paineis para a versão do Power BI Desktop adaptado para RS, versão maio 2023"
                description: "Deploy do protótipo de Bolsa na Prodest, sem live coonection"
            }
        }
    }

    epic epico {
        name: "Ajeitar Semana"


        story ajudarBackEnd {
            name: "Ajudar o Backend no Made"

            task ajudarBackendMade {
                name: "Ajudar o Backend no Made"
                description: "Ajudar o backend a entender o Made e como ele pode ser utilizado para gerenciar as tarefas"
            }

            task ajudarBackendDocker {
                name: "Ajudar o Backend com problemas no docker"
            }
        }

        story RoadmapFrancisco {
            name: "Roadmap com as entregas do ano de 2024"
            description: "Roadmap com as entregas do ano de 2024, para apresentação para o francisco"

            task RoadmapComInfraestrutura {
                name: "Roadmap"
                description: "Roadmap no excalidraw com toda infraestrutura do projeto atual, Docker, GitHub, Airflow, PowerBI"
            }

            task RoadmapComEntregas {
                name: "Entregas no Roadmap"
                description: "Roadmap no excalidraw com os objetivos cumpridos, planejados e aqueles que serão feitos, onde evoluímos e o que temos atualmente. Além de
                colocar visualmente o power BI que temos e processo de ETL e todo o processo até a criação do primeiro dashboard"
            }    
            
        }

        story posReuniao {
            name: "Pos Reunião"
            description: "Pos reunião com o Francisco para alinhar as entregas do ano de 2024 e futuro"
            depends: BacklogSprint4.epico.RoadmapFrancisco

            task anotarDemandas {
                name: "Anotar demandas"
                description: "Anotar as demandas que temos para as proximas semanas, utilizando com base a reunião"
            }

            task fazerPlanejamento {
                name: "Fazer planejamento"
                description: "Reunião com Felipe para planejar dos dias 09 ao 24 de janeiro de 2025 as entregas"
                depends: BacklogSprint4.epico.posReuniao.anotarDemandas
            }

            task atualizarMade {
                name: "Atualizar Made"
                description: "Atualizar o Made com as entregas planejadas"
                depends: BacklogSprint4.epico.posReuniao.fazerPlanejamento
            } 
               

        }

        story adicionarGraficosNoDashboardBolsa {
            name: "Adicionar gráficos no Dashboard de Bolsa"
            description: "Adicionar gráficos no Dashboard de Bolsa para melhorar a visualização dos dados"

            task inspiracaoDeGraficos {
                name: "Inspirar gráficos"
                description: "Procurar inspirações, olhar os dados, analisar cases de gráficos para adicionar no Dashboard de Bolsa"
            }

            task prototiparDashboard {
                name: "Prototipar novo Dashboard de Bolsa"
                depends: BacklogSprint4.epico.adicionarGraficosNoDashboardBolsa.inspiracaoDeGraficos
            }
        }

        story melhorarDesignDashboard {
            name: "Melhorar Design Dashboard"

            task inspiracao {
                name: "inspirar Design Dashboard de Bolsa"
                description: "Procurar inspirações de design de dashboard para melhorar o design do dashboard de Bolsa atual"
            }

            task implementarDesign {
                name: "Implementar Design Dashboard de Bolsa"
                description: "Implementar o design do dashboard de Bolsa atual"
            }    
        }



     
    }

}

backlog backlogSprint5 {
    name: "Desenvolver Dashboard de Bolsa"

    epic atualizarMade {
        name: "Atualizar Made"
        description: "Atualizar o Made com as entregas planejadas"

        story atualizarMade {
            name: "Atualizar Made"
            description: "Atualizar o Made com as entregas planejadas"
        }
    }

    epic desenvolverDashboardBolsa {
        name: "Desenvolver Dashboard de Bolsa"
        description: "Desenvolver o Dashboard de Bolsa com as métricas definidas"


        story aprimorarPrototipoPainelBolsa {
            name: "Aprimorar Protótipo do Painel de Bolsa"
            description: "Aprimorar o protótipo do Painel de Bolsa com feedback do Moises"

            task aprimorarPrototipoPainelBolsaMoises {
                name: "Aprimorar Protótipo do Painel de Bolsa"
                description: "Aprimorar o protótipo do Painel de Bolsa com feedback do Moises"
            }

            task criarNovaPagina {
                name: "Criar nova página de Bolsa"
                description: "nova página com dagboard de distribuição de bolsa por mes, Bolsistas por municipio e um mapa"
            }

            task aprimorarPrototipoPainelBolsaVitor {
                name: "Aprimorar Protótipo do Painel de Bolsa"
                description: "Aprimorar o protótipo do Painel de Bolsa com feedback do Vitor"
            }
        }

        story criacaoDeDAGSBolsa {
            name: "Desenvolver Dashboard de Bolsa"
            description: "Desenvolver o Dashboard de Bolsa com as métricas definidas"

            task criarDagsDeBolsa {
                name: "Criar DAGs com tratamento de dados para Bolsa"
                description: "Criar DAGs com tratamento de dados no Apache Airflow para o painel de Bolsas"
            }
        }



        story LiveConnection {
            name: "Estudar e implantar Live Connection"
            description: "Estudar e implantar Live Connection no Power BI"

            task estudarLiveConnection {
                name: "Estudar Live Connection"
                description: "Estudar como implantar Live Connection no Power BI"
            }

            task implantarLiveConnection {
                name: "Implantar Live Connection"
                description: "Implantar Live Connection no Power BI"
            }
        }
        
        story tratamentoDeDadosBolsaPowerQuery {
            name: "Tratamento de Dados de Bolsa com Power Query"
            description: "Tratar os dados de Bolsa com Power Query no Power BI"

            task tratarDadosBolsa {
                name: "Tratar dados de Bolsa"
                description: "Tratar os dados de Bolsa no Power BI com Power Query"
                depends: backlogSprint5.desenvolverDashboardBolsa.criacaoDeDAGSBolsa
            }
        }
    }
}

