backlog PagamentoBolsistaII {
   name: "Backlog - Janeiro-2025"
   description: "Backlog dedicado a estudo da equipe"

    epic E001 {
        name: "Realizar deploy da primeira versão do sistema do Pagamento Bolsista I"
        description: "Objetivo: Conseguir entregar uma versão estável no nosso ambiente de desenvolvimento para testes"

        story S001 {
            name: "Deploy Job Importação"
            
            task documentation { name: "Documentar a arquitetura do hangfire" }
            task autenticacao { name: "Adaptar a autenticação do job de importação" }
            task deploy_jb_importacao { name: "Deploy do Job Importação" }
        }

        story S002 {
            name: "Deploy da API Pagamento Bolsista I"
            
            task deploy_api_pg1 { name: "Deploy da API Pagamento Bolsista I" }
        }
    }

    epic E002 {
        name: "Desenvolvimento da API Pagamento Bolsista I"
        description: "Objetivo: Adaptar a API Pagamento Bolsista I para iniciar a fase II do desenvolvimento"

        story S003 {
            name: "Remover paginação das telas do módulo Pagamento Bolsista I"
            
            task remover_pagination_api { name: "Criar rotas customizadas para o módulo Pagamento Bolsista I" }
            task integration_pagination_api { name: "Integrar as telas do módulo Pagamento Bolsista I com as novas rotas" }
        }
    }

    epic E003 {
        name: "Desenvolvimento da API Pagamento Bolsista II"
        description: "Objetivo: Desenvolver da API Pagamento Bolsista II"
        

        story S005 {
            name: "Implementar as telas do módulo Pagamento Bolsista II"
            
            task tela_monitorar_remessa { name: "Implementar a tela de Monitorar Remessa" }
            task tela_solicitar_recurso { name: "Implementar a tela de Solicitar Rescurso" }
        }

        story S006 {
            name: "Reuniões"
            
            task meet_edi { name: "Reunião para tratar sobre o @EDI do baneste" }
            task meet_batch { name: "Reunião sobre o processo de gerar arquivo de remessa" }
        }

        story S007 {
            name: "Especificação do módulo Pagamento Bolsista II"
            
            task especificacao_arq_remessa { name: "Criar seção de regra de negócios para especificação Pagto II" }
            task especificacao_arq_regra_remessa { name: "Resumir as regras de remessa e retorno do Banestes" }
            task especificacao_diagrama { name: "Adequar os diagramas de projetos" }
        }

        story S008 {
            name: "Gerar Arquivo de Remessa"
            
            task gerar_arq_remessa_pgt { name: "Gerar Arquivo de Remessa de Pagamento" }
            task gerar_arq_remessa_cad { name: "Gerar Arquivo de Remessa de Cadastro Bolsista" }
        }
    }
   
   
}

