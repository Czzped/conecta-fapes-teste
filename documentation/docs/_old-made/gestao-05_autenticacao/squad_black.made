    teammember gianpaneto {name: "Gian Paneto" email: "gianpaneto@gmail.com"}
    teammember arthurcremasco {name: "Arthur Cremasco" email: "arthurcremascoamaral7@gmail.com"}
    teammember sofiadealcantara {name: "Sofia de Alcantara" email: "sofiaalcantaras@outlook.com"}
    teammember joaomarcos {name: "João Marcos" email: "joaomarcosrpimentel@gmail.com"}  
}


backlog janeiro25 {
   name: "Backlog - Janeiro/2024"
   description: "Objetivos Gerais:
                1. Fazer deploy do sistema de autorização e logging no nosso servidor (developing2)"
  
   epic E001 {
        name: "Realizar deploy da primeira versão do sistema."
        description: "Objetivo: Conseguir entregar uma versão estável no nosso ambiente de desenvolvimento para testes."

    story S001 {
        name: "Definir políticas de acesso"
        
        task documentation { name: "Documentar as políticas implementadas" }
        task testing { name: "Testar as políticas implementadas" }
    }

    story S002 {
        name: "Implementar verificação de cargos usando JWT"
    
        task jwt_development { name: "Desenvolver módulo de verificação de endpoint utilizando informações do JWT" }
        task jwt_test { name: "Testar autorização de rotas com o JWT"  }
        task jwt_benchmark { name: "Fazer benchmark do sistema utilizando com a autorização de rotas implementada"  }
        task deploy { name: "Fazer deploy do sistema implementado para o nosso servidor" }
        task documentation { name: "Documentar gateway e criar apresentação para o time" }
    }

    story S003 {
        name: "Desenvolver um frontend admin para o OpenFGA"
        
        task route_front { name: "Desenvolver tela de definição de permissões por rota" }
        task deploy { name: "Fazer deploy do sistema implementado para o nosso servidor" }
    }
    }
}

