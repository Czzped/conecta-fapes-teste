project BlackSquad {
    name: "Black Squad Conecta Fapes"
    description: "Autorização e logging do Conecta Fapes."
    startDate: 01/12/2024
    dueDate: 31/12/2025
}

team black_squad {
    name: "Black Squad"
    description: "Equipe responsável pela autorização e logging do Conecta Fapes"
