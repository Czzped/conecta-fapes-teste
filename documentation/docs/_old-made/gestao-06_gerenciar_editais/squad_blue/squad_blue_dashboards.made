project dashboards {
    name: "Dashboards para Gerenciamento dos Editais"
    description: "Dashboards para auxiliar nas tomadas de decisão das Áreas Técnicas da FAPES sobre os Editais e Projetos"
    startDate: 03/11/2024
    dueDate: 01/02/2025
}

